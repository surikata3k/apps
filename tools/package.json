{
  "name": "surikata3k-tools",
  "private": true,
  "description": "Builds the Tailwind CSS and the Lucide icon bundle used by the apps.",
  "scripts": {
    "css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o ../assets/tailwind.min.css --minify",
    "icons": "node lucide-collect.js ../*.html ../*/*.html && esbuild entry.js --bundle --minify --format=iife --outfile=../assets/lucide.min.js",
    "build": "npm run css && npm run icons"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lucide": "1.69.0",
    "tailwindcss": "^3.4.19"
  }
}
